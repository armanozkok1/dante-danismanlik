---
// src/components/Hero.astro
import Header from "./Header.astro";
---

<section class="relative w-full h-screen h-[100dvh] overflow-hidden bg-[#120E0C]">
  <!-- Arka Plan Görseli: Tüm ekranı kaplayacak ve dikey kaydırma oluşturmayacak şekilde tam oturur -->
  <img
    src="/images/hero/hero-bg-clean.jpg"
    alt="Dante Hero Arka Plan"
    class="w-full h-full object-cover object-bottom select-none pointer-events-none"
    loading="eager"
  />

  <!-- Şeffaf Header (Fotoğrafın üstünde) -->
  <Header />

  <!-- İçerik Katmanı (Gelecek adımlardaki başlık, metin ve butonlar için) -->
  <div class="absolute inset-0 z-10 flex flex-col justify-between pointer-events-none">
    <slot />
  </div>
</section>

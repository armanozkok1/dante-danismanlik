---
// src/components/Hero.astro
import Header from "./Header.astro";
---

<section class="relative w-full h-screen min-h-[600px] bg-[#120E0C] overflow-hidden">
  <!-- 1. Arka Plan Görseli: Kenardan kenara tam ekran -->
  <img
    src="/hero-bg-clean.jpg"
    alt="Dante Hero Arka Plan"
    class="absolute inset-0 w-full h-full object-cover object-center z-0"
    loading="eager"
  />

  <!-- 2. Şeffaf Header (Ascend tarzı, fotoğrafın tam üstünde) -->
  <Header />

  <!-- 3. İçerik Katmanı (Gelecek adımlardaki başlık ve butonlar için) -->
  <div class="relative z-10 w-full h-full flex flex-col justify-between pointer-events-none">
    <slot />
  </div>
</section>
